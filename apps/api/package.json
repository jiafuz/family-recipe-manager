{
  "name": "@jiayan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@jiayan/contracts": "0.1.0",
    "@jiayan/domain": "0.1.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "jose": "6.2.4",
    "mysql2": "3.23.1",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
