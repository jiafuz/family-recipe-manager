NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# 本地快速开发默认使用内存；联调 MySQL 时改为 mysql。
PERSISTENCE_MODE=memory
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=jiayan
DATABASE_USER=jiayan
DATABASE_PASSWORD=jiayan-local-only
DATABASE_CONNECTION_LIMIT=10

# 本地默认 mock；接入微信测试号或正式小程序后改为 live。
WECHAT_LOGIN_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 本地内存联调使用 mock；体验版和生产环境必须使用 cos。
MEDIA_STORAGE_MODE=mock
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# 生产环境必须替换为密码管理器生成的随机密钥，不得提交真实值。
AUTH_ACCESS_TOKEN_SECRET=dev-only-access-token-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
IDENTITY_HASH_SECRET=dev-only-identity-hash-secret-change-me
INVITE_CODE_SECRET=dev-only-invite-code-secret-change-me
